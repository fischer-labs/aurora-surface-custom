# Copy to roost/.env and edit. Never commit .env.

# Unlisted path for the web app. Generate one: deploy/new-web-path.sh
ROOST_WEB_PATH=/h/change-me/

# Default time zone for new families (IANA name).
ROOST_TIMEZONE=America/Chicago

# Optional: a local LLM (Ollama, llama.cpp, vLLM, LM Studio — OpenAI-compatible)
# sorts grocery items the built-in dictionary doesn't know.
# ROOST_LLM_URL=http://host.docker.internal:11434/v1
# ROOST_LLM_MODEL=llama3.1:8b

# Allow subscribing to calendar feeds on your LAN (e.g. a NAS). Off by default.
# ROOST_ALLOW_PRIVATE_FEEDS=1

# Cloudflare Tunnel token (only with `--profile tunnel`).
# CLOUDFLARE_TUNNEL_TOKEN=
