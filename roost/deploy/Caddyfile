# Caddy reverse proxy with automatic HTTPS (alternative to Cloudflare Tunnel).
# Point a DNS record at this machine, open ports 80/443, then: caddy run
family.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8090
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
