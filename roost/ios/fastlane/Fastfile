# TestFlight automation. Requires an App Store Connect API key:
#   export ASC_KEY_ID=... ASC_ISSUER_ID=... ASC_KEY_PATH=~/keys/AuthKey_XXXX.p8
#   export ROOST_BUNDLE_ID=com.yourname.roost ROOST_TEAM_ID=ABCDE12345
#   cd roost/ios && fastlane beta
default_platform(:ios)

platform :ios do
  def api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("ASC_KEY_PATH"))
    )
  end

  desc "Create the app record in App Store Connect (one time)"
  lane :create_app do
    produce(
      app_identifier: ENV.fetch("ROOST_BUNDLE_ID"),
      app_name: ENV["ROOST_APP_NAME"] || "Roost Family",
      sku: "roost-#{ENV.fetch('ROOST_BUNDLE_ID')}",
      skip_itc: false
    )
  end

  desc "Build and upload a new build to TestFlight"
  lane :beta do
    key = api_key
    sh("cd .. && xcodegen generate") if system("command -v xcodegen > /dev/null")
    build = (latest_testflight_build_number(api_key: key, initial_build_number: 0) rescue 0) + 1
    build_app(
      project: "Roost.xcodeproj",
      scheme: "Roost",
      configuration: "Release",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates CURRENT_PROJECT_VERSION=#{build} DEVELOPMENT_TEAM=#{ENV.fetch('ROOST_TEAM_ID')} ROOST_BUNDLE_ID=#{ENV.fetch('ROOST_BUNDLE_ID')}",
      output_directory: "build"
    )
    upload_to_testflight(api_key: key, skip_waiting_for_build_processing: true, distribute_external: false)
  end
end
